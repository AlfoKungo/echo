    {
      "id": "s-z",
      "title": "s or z",
      "level": "A2",
      "labels": ["s", "z"],
      "listen": "The s sound is a plain hiss with no voice in it; the z sound buzzes. Put a finger on your throat: it shakes for z and stays still for s. This matters most after ils, elles, nous and vous, where a buzzing z means the next word started with a vowel — ils ont, not ils sont.",
      "items": [
        { "id": "s-z-ils-sont", "a": { "fr": "ils sont", "en": "they are" }, "b": { "fr": "ils ont", "en": "they have" } },
        { "id": "s-z-elles-sont", "a": { "fr": "elles sont", "en": "they are (women)" }, "b": { "fr": "elles ont", "en": "they have (women)" } },
        { "id": "s-z-nous-savons", "a": { "fr": "nous savons", "en": "we know" }, "b": { "fr": "nous avons", "en": "we have" } },
        { "id": "s-z-vous-savez", "a": { "fr": "vous savez", "en": "you know" }, "b": { "fr": "vous avez", "en": "you have" } },
        { "id": "s-z-savez-tout", "a": { "fr": "vous savez tout", "en": "you know everything" }, "b": { "fr": "vous avez tout", "en": "you have everything" } },
        { "id": "s-z-savons-ca", "a": { "fr": "nous savons ça", "en": "we know that" }, "b": { "fr": "nous avons ça", "en": "we have that" } },
        { "id": "s-z-poisson", "a": { "fr": "le poisson", "en": "the fish" }, "b": { "fr": "le poison", "en": "the poison" } },
        { "id": "s-z-dessert", "a": { "fr": "le dessert", "en": "the dessert" }, "b": { "fr": "le désert", "en": "the desert" } },
