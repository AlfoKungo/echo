    {
      "id": "un-une",
      "title": "un or une",
      "level": "A1",
      "labels": ["un", "une"],
      "listen": "Un goes out through your nose with the mouth barely open and nothing crisp at the end. Une starts with your lips in a tight little circle and finishes on a clear \"n\", tongue touching just behind your top teeth. Listen for whether the word ends with that n.",
      "items": [
        { "id": "un-une-ami", "a": { "fr": "un ami", "en": "a friend (a man)" }, "b": { "fr": "une amie", "en": "a friend (a woman)" } },
        { "id": "un-une-eleve", "a": { "fr": "un élève", "en": "a pupil (a boy)" }, "b": { "fr": "une élève", "en": "a pupil (a girl)" } },
        { "id": "un-une-collegue", "a": { "fr": "un collègue", "en": "a colleague (a man)" }, "b": { "fr": "une collègue", "en": "a colleague (a woman)" } },
        { "id": "un-une-touriste", "a": { "fr": "un touriste", "en": "a tourist (a man)" }, "b": { "fr": "une touriste", "en": "a tourist (a woman)" } },
