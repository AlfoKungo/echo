    {
      "id": "on-an",
      "title": "on or an",
      "level": "A2",
      "labels": ["on", "an"],
      "listen": "Both of these hum through the nose. For on the lips push forward into a small round hole, as if you were starting to say \"oh\". For an the mouth drops wide open, like the \"a\" in \"father\" sent through the nose. Watching a speaker's lips is the quickest tell: round means on, open means an.",
      "items": [
        { "id": "on-an-bon", "a": { "fr": "bon", "en": "good" }, "b": { "fr": "banc", "en": "bench" } },
        { "id": "on-an-son-sac", "a": { "fr": "son sac", "en": "his bag" }, "b": { "fr": "sans sac", "en": "without a bag" } },
        { "id": "on-an-son-livre", "a": { "fr": "son livre", "en": "her book" }, "b": { "fr": "sans livre", "en": "without a book" } },
        { "id": "on-an-long", "a": { "fr": "c’est long", "en": "it is long" }, "b": { "fr": "c’est lent", "en": "it is slow" } },
        { "id": "on-an-ton", "a": { "fr": "ton", "en": "your" }, "b": { "fr": "temps", "en": "time, weather" } },
        { "id": "on-an-blond", "a": { "fr": "il est blond", "en": "he is blond" }, "b": { "fr": "il est blanc", "en": "it is white" } },
        { "id": "on-an-rond", "a": { "fr": "un rond", "en": "a circle" }, "b": { "fr": "un rang", "en": "a row" } },
        { "id": "on-an-talon", "a": { "fr": "le talon", "en": "the heel" }, "b": { "fr": "le talent", "en": "the talent" } },
        { "id": "on-an-savon", "a": { "fr": "le savon", "en": "the soap" }, "b": { "fr": "le savant", "en": "the scientist" } }
