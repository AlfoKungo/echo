    {
      "id": "il-ils",
      "title": "il or ils",
      "level": "A2",
      "labels": ["il", "ils"],
      "listen": "The s of ils is silent on its own, but before a verb starting with a vowel it comes back as a buzzing z that glues the two words together: il aime sounds like \"ee-lem\", ils aiment like \"eel-zem\". That buzz, and sometimes a consonant sounded at the end of the verb, is the only sign that there is more than one person.",
      "items": [
        { "id": "il-ils-aime", "a": { "fr": "il aime ça", "en": "he likes that" }, "b": { "fr": "ils aiment ça", "en": "they like that" } },
