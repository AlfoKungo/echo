    {
      "id": "u-ou",
      "title": "u or ou",
      "level": "A1",
      "labels": ["u", "ou"],
      "listen": "For u, say \"ee\" as in \"see\", then push your lips forward into a tight circle without moving your tongue — the tongue stays right at the front. For ou the tongue pulls back and you get the \"oo\" of \"food\". If it sounds like a normal English \"oo\", it is ou.",
      "items": [
        { "id": "u-ou-tu", "a": { "fr": "tu", "en": "you" }, "b": { "fr": "tout", "en": "everything" } },
        { "id": "u-ou-tu-vas", "a": { "fr": "tu vas bien", "en": "you are doing well" }, "b": { "fr": "tout va bien", "en": "everything is fine" } },
        { "id": "u-ou-rue", "a": { "fr": "la rue", "en": "the street" }, "b": { "fr": "la roue", "en": "the wheel" } },
        { "id": "u-ou-dessus", "a": { "fr": "au-dessus", "en": "above" }, "b": { "fr": "au-dessous", "en": "below" } },
        { "id": "u-ou-vu", "a": { "fr": "vu", "en": "seen" }, "b": { "fr": "vous", "en": "you (polite or plural)" } },
        { "id": "u-ou-russe", "a": { "fr": "elle est russe", "en": "she is Russian" }, "b": { "fr": "elle est rousse", "en": "she is a redhead" } },
        { "id": "u-ou-buche", "a": { "fr": "la bûche", "en": "the log" }, "b": { "fr": "la bouche", "en": "the mouth" } },
