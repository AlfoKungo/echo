    {
      "id": "le-les",
      "title": "le or les",
      "level": "A1",
      "labels": ["le", "les"],
      "listen": "Le is short and soft, a quick \"luh\" with the lips pushed forward. Les sounds like the English word \"lay\". The noun after them sounds exactly the same in the singular and the plural, so that one little word is the only thing telling you how many there are.",
      "items": [
        { "id": "le-les-chat", "a": { "fr": "le chat", "en": "the cat" }, "b": { "fr": "les chats", "en": "the cats" } },
        { "id": "le-les-livre", "a": { "fr": "je ferme le livre", "en": "I close the book" }, "b": { "fr": "je ferme les livres", "en": "I close the books" } },
        { "id": "le-les-gateau", "a": { "fr": "le gâteau", "en": "the cake" }, "b": { "fr": "les gâteaux", "en": "the cakes" } },
        { "id": "le-les-train", "a": { "fr": "le train", "en": "the train" }, "b": { "fr": "les trains", "en": "the trains" } },
        { "id": "le-les-voisin", "a": { "fr": "le voisin", "en": "the neighbour" }, "b": { "fr": "les voisins", "en": "the neighbours" } },
        { "id": "le-les-film", "a": { "fr": "j’aime le film", "en": "I like the film" }, "b": { "fr": "j’aime les films", "en": "I like the films" } },
        { "id": "le-les-verre", "a": { "fr": "le verre", "en": "the glass" }, "b": { "fr": "les verres", "en": "the glasses" } },
        { "id": "le-les-magasin", "a": { "fr": "le magasin", "en": "the shop" }, "b": { "fr": "les magasins", "en": "the shops" } },
        { "id": "le-les-sac", "a": { "fr": "le sac", "en": "the bag" }, "b": { "fr": "les sacs", "en": "the bags" } },
        { "id": "le-les-jour", "a": { "fr": "le jour", "en": "the day" }, "b": { "fr": "les jours", "en": "the days" } }
      ]
